# Gateway Caddyfile serving two independent apps side by side
# (server: /home/faruqe/gateway/Caddyfile, mounted into the gateway-caddy-1 container).
#
#   http://<server>/maplemetrics/  -> MapleMetrics  (127.0.0.1:8000)
#   http://<server>/hansardlens/   -> HansardLens   (127.0.0.1:8010)
#
# handle_path strips the prefix before forwarding; each app adds it back to its links
# (HansardLens: DJANGO_SCRIPT_NAME=/hansardlens). The two paths do not overlap, so
# neither block can affect the other. Verified with Caddy 2.10.

:80 {
	redir /maplemetrics /maplemetrics/ permanent
	redir /hansardlens /hansardlens/ permanent

	# MapleMetrics
	handle_path /maplemetrics/* {
		reverse_proxy 127.0.0.1:8000
	}

	# HansardLens
	handle_path /hansardlens/* {
		reverse_proxy 127.0.0.1:8010
	}

	handle {
		respond "Server is running. Projects: /maplemetrics/ /hansardlens/" 200
	}
}
