# Copy to .env. For production also set DJANGO_SECRET_KEY to a long random value:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10
# DJANGO_SCRIPT_NAME=/hansardlens   # when served under a sub-path by a proxy
# DJANGO_HTTPS=1            # secure cookies, HSTS and HTTPS redirect once served over HTTPS
# DJANGO_BEHIND_PROXY=1     # trust X-Forwarded-Proto from a reverse proxy
HANSARD_CACHE=file
API_RATE=120/minute
POSTGRES_DB=hansardlens
POSTGRES_USER=hansardlens
POSTGRES_PASSWORD=hansardlens
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Production stack only (docker-compose.prod.yml)
# HANSARD_PORT=8010         # loopback port the reverse proxy forwards to
# GUNICORN_WORKERS=2
# BACKUP_AT=02:30           # nightly database dump, local time
# BACKUP_KEEP=3             # how many dumps to keep in data/backups
# Monitoring (optional), e.g. Healthchecks.io check URLs; you get an email when a run
# fails or no success arrives on time:
# REFRESH_HEALTHCHECK_URL=https://hc-ping.com/<uuid-for-daily-refresh>
# BACKUP_HEALTHCHECK_URL=https://hc-ping.com/<uuid-for-nightly-backup>
