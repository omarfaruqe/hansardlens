        <SubjectOfBusinessTitle>Les ponts du port</SubjectOfBusinessTitle>
        <SubjectOfBusinessContent>
          <Timestamp Hr="10" Mn="05">(1005)</Timestamp>
          <Intervention Type="Debate" ToC="Yes" ToCText="Mme Alder" id="1001">
            <PersonSpeaking><Affiliation DbId="501" Type="2">Mme Jane Alder (Riverbend—North Shore, PCC)</Affiliation>: </PersonSpeaking>
            <Content>
              <ParaText id="2001">Monsieur le Président, le pont de ma circonscription a ouvert la semaine dernière.</ParaText>
              <FloorLanguage language="FR">[<I>Français</I>]</FloorLanguage>
              <ParaText id="2002">Il relie la circonscription de <Affiliation DbId="502" Type="2">Luc Martel</Affiliation> à la mienne.</ParaText>
            </Content>
          </Intervention>
        </SubjectOfBusinessContent>
      </SubjectOfBusiness>
