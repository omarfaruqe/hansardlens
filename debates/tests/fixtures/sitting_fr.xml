    <OrderOfBusiness id="920" Rubric="OralQuestionPeriod">
      <OrderOfBusinessTitle>Questions orales</OrderOfBusinessTitle>
      <SubjectOfBusiness id="921">
        <SubjectOfBusinessTitle>Le logement</SubjectOfBusinessTitle>
        <SubjectOfBusinessContent>
          <Intervention Type="Debate" ToC="Yes" ToCText="M. Martel" id="1002">
            <PersonSpeaking><Affiliation DbId="502" Type="2">M. Luc Martel (Lac-Bleu, BQ)</Affiliation>: </PersonSpeaking>
            <Content><ParaText id="2003">Monsieur le Président, les loyers augmentent toujours.</ParaText></Content>
          </Intervention>
          <Intervention Type="Answer" ToC="Yes" ToCText="M. Okafor" id="1003">
            <PersonSpeaking><Affiliation DbId="503" Type="5">L'hon. Sam Okafor (secrétaire d'État (Logement), Lib.)</Affiliation>: </PersonSpeaking>
            <Content>
              <Timestamp Hr="14" Mn="20">(1420)</Timestamp>
              <FloorLanguage language="EN">[<I>Traduction</I>]</FloorLanguage>
              <ParaText id="2004">Monsieur le Président, nous construisons plus de logements.</ParaText>
            </Content>
          </Intervention>
          <Intervention Type="Interjection" ToC="No" ToCText="Le Président" id="1004">
            <PersonSpeaking><Affiliation DbId="504" Type="96">Le Président</Affiliation>: </PersonSpeaking>
            <Content><ParaText id="2005">À l'ordre.</ParaText></Content>
          </Intervention>
          <Intervention Type="Question" ToC="Yes" ToCText="M. Martel" id="1005">
            <PersonSpeaking><Affiliation DbId="502" Type="2">M. Luc Martel</Affiliation>: </PersonSpeaking>
            <Content><ParaText id="2006">Quand les loyers baisseront-ils?</ParaText></Content>
          </Intervention>
          <Intervention Type="Interjection" ToC="No" ToCText="La vice-présidente adjointe" id="1006">
            <PersonSpeaking><Affiliation DbId="505" Type="92">La vice-présidente adjointe (Mme Rosa Lind)</Affiliation>: </PersonSpeaking>
            <Content><ProceduralText id="3">(La séance est suspendue à 14 h 30.)</ProceduralText></Content>
          </Intervention>
        </SubjectOfBusinessContent>
